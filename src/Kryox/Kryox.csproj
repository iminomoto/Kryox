<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Kryox</AssemblyName>
    <RootNamespace>Kryox</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.2.5</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hardware sensors: CPU temperature (incl. via WinRing0), NVIDIA/AMD/Intel temps -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <!-- Renders the 1-bit HTML dashboard offscreen at 320x240 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dashboard-1bit.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\kryox-mark.png" />
  </ItemGroup>

</Project>
