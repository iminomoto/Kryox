<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>KryoxTest</AssemblyName>
    <RootNamespace>KryoxTest</RootNamespace>
    <ApplicationManifest>..\Kryox\app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Kryox\Lm360Display.cs" />
    <Compile Include="..\Kryox\SplashFrame.cs" />
    <Compile Include="..\Kryox\Sensors.cs" />
    <Compile Include="..\Kryox\WinUsbDevice.cs" />
    <Compile Include="..\Kryox\WebDashboard.cs" />
    <EmbeddedResource Include="..\Kryox\Web\dashboard-1bit.html" />
    <EmbeddedResource Include="..\Kryox\Assets\kryox-mark.png" />
  </ItemGroup>

</Project>
